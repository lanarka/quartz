// ============================================================================
// draw_calc_window
// ============================================================================
draw_calc_window:
	load u32 #0 1865876
	load u32 #1 1865880

	// title bar
	movi u16 #2 300
	movi u16 #3 26
	movi u32 #4 1438336
	movi u32 #5 $std.BUS_DEV_VIDEO
	movi u32 #6 $std.VIDEO_PORT_X
	busout #5 #6 #0
	movi u32 #6 $std.VIDEO_PORT_Y
	busout #5 #6 #1
	movi u32 #6 $std.VIDEO_PORT_W
	busout #5 #6 #2
	movi u32 #6 $std.VIDEO_PORT_H
	busout #5 #6 #3
	movi u32 #6 $std.VIDEO_CMD_FRAME
	movi u32 #7 31200
	busoutb #5 #6 #4 #7 #8

	// body
	load u32 #0 1865876
	load u32 #1 1865880
	addi u32 #1 26
	movi u16 #2 300
	movi u16 #3 194
	movi u32 #4 1469536
	movi u32 #5 $std.BUS_DEV_VIDEO
	movi u32 #6 $std.VIDEO_PORT_X
	busout #5 #6 #0
	movi u32 #6 $std.VIDEO_PORT_Y
	busout #5 #6 #1
	movi u32 #6 $std.VIDEO_PORT_W
	busout #5 #6 #2
	movi u32 #6 $std.VIDEO_PORT_H
	busout #5 #6 #3
	movi u32 #6 $std.VIDEO_CMD_FRAME
	movi u32 #7 232800
	busoutb #5 #6 #4 #7 #8

	// outer border
	load u32 #0 1865876
	store u32 1865904 #0
	load u32 #0 1865880
	store u32 1865908 #0
	movi u32 #0 300
	store u32 1865912 #0
	movi u32 #0 220
	store u32 1865916 #0
	movi u32 #0 0xFF404040
	store u32 1865920 #0
	call draw_border

	// close box
	load u32 #0 1865876
	addi u32 #0 278
	store u32 1866064 #0
	load u32 #0 1866064
	load u32 #1 1865880
	addi u32 #1 4
	movi u16 #2 18
	movi u16 #3 18
	movi u32 #4 1702336
	movi u32 #5 $std.BUS_DEV_VIDEO
	movi u32 #6 $std.VIDEO_PORT_X
	busout #5 #6 #0
	movi u32 #6 $std.VIDEO_PORT_Y
	busout #5 #6 #1
	movi u32 #6 $std.VIDEO_PORT_W
	busout #5 #6 #2
	movi u32 #6 $std.VIDEO_PORT_H
	busout #5 #6 #3
	movi u32 #6 $std.VIDEO_CMD_FRAME
	movi u32 #7 1296
	busoutb #5 #6 #4 #7 #8

	load u32 #0 1866064
	store u32 1865904 #0
	load u32 #0 1865880
	addi u32 #0 4
	store u32 1865908 #0
	movi u32 #0 18
	store u32 1865912 #0
	movi u32 #0 18
	store u32 1865916 #0
	movi u32 #0 0xFF404040
	store u32 1865920 #0
	call draw_border

	load u32 #0 1866064
	addi u32 #0 5
	store u32 1865904 #0
	load u32 #0 1865880
	addi u32 #0 6
	store u32 1865908 #0
	movi u32 #0 88
	store u32 1865912 #0
	movi u32 #0 50752
	store u32 1865916 #0
	call draw_char

	// title text "Calculator"
	load u32 #0 1865876
	addi u32 #0 8
	store u32 1865904 #0
	load u32 #0 1865880
	addi u32 #0 6
	store u32 1865908 #0
	movi u32 #0 1322148
	store u32 1865912 #0
	movi u32 #0 10
	store u32 1865916 #0
	movi u32 #0 8192
	store u32 1865920 #0
	call draw_text

	// display
	load u32 #0 1865876
	addi u32 #0 8
	load u32 #1 1865880
	addi u32 #1 30
	movi u16 #2 284
	movi u16 #3 28
	movi u32 #4 1834032
	movi u32 #5 $std.BUS_DEV_VIDEO
	movi u32 #6 $std.VIDEO_PORT_X
	busout #5 #6 #0
	movi u32 #6 $std.VIDEO_PORT_Y
	busout #5 #6 #1
	movi u32 #6 $std.VIDEO_PORT_W
	busout #5 #6 #2
	movi u32 #6 $std.VIDEO_PORT_H
	busout #5 #6 #3
	movi u32 #6 $std.VIDEO_CMD_FRAME
	movi u32 #7 31808
	busoutb #5 #6 #4 #7 #8

	load u32 #0 1865876
	addi u32 #0 8
	store u32 1865904 #0
	load u32 #0 1865880
	addi u32 #0 30
	store u32 1865908 #0
	movi u32 #0 284
	store u32 1865912 #0
	movi u32 #0 28
	store u32 1865916 #0
	movi u32 #0 0xFF808080
	store u32 1865920 #0
	call draw_border

	call calc_format_display
	// right-align the text within the display box (284px wide, 8px/char)
	load u32 #0 1865944
	mov #1 #0
	movi u32 #2 8
	mul u32 #1 #2
	movi u32 #3 276
	sub u32 #3 #1
	load u32 #4 1865876
	add u32 #3 #4
	store u32 1865904 #3
	load u32 #4 1865880
	addi u32 #4 37
	store u32 1865908 #4
	movi u32 #4 1866136
	store u32 1865912 #4
	store u32 1865916 #0
	movi u32 #4 50752
	store u32 1865920 #4
	call draw_text

	// button grid
	movi u32 #0 0
dcw_btn_loop:
	cmpi u32 #0 16
	jge dcw_btn_done
	store u32 1866068 #0

	mov #1 #0
	movi u32 #2 4
	div u32 #1 #2         // row = i/4
	mov #3 #0
	mod u32 #3 #2         // col = i%4

	// relX = 8 + col*71 ; relY = 64 + row*38
	mov #4 #3
	movi u32 #5 71
	mul u32 #4 #5
	addi u32 #4 8
	mov #6 #1
	movi u32 #7 38
	mul u32 #6 #7
	addi u32 #6 64

	load u32 #8 1865876
	add u32 #8 #4
	store u32 1866072 #8         // abs x
	load u32 #9 1865880
	add u32 #9 #6
	store u32 1866076 #9         // abs y

	load u32 #0 1866072
	load u32 #1 1866076
	movi u16 #2 65
	movi u16 #3 32
	movi u32 #4 1825712
	movi u32 #5 $std.BUS_DEV_VIDEO
	movi u32 #6 $std.VIDEO_PORT_X
	busout #5 #6 #0
	movi u32 #6 $std.VIDEO_PORT_Y
	busout #5 #6 #1
	movi u32 #6 $std.VIDEO_PORT_W
	busout #5 #6 #2
	movi u32 #6 $std.VIDEO_PORT_H
	busout #5 #6 #3
	movi u32 #6 $std.VIDEO_CMD_FRAME
	movi u32 #7 8320
	busoutb #5 #6 #4 #7 #8

	load u32 #0 1866072
	store u32 1865904 #0
	load u32 #0 1866076
	store u32 1865908 #0
	movi u32 #0 65
	store u32 1865912 #0
	movi u32 #0 32
	store u32 1865916 #0
	movi u32 #0 0xFF808080
	store u32 1865920 #0
	call draw_border

	movi u32 #0 1866104
	load u32 #1 1866068
	add u32 #0 #1
	loadr u8 #2 #0

	load u32 #0 1866072
	addi u32 #0 28
	store u32 1865904 #0
	load u32 #0 1866076
	addi u32 #0 9
	store u32 1865908 #0
	store u32 1865912 #2
	movi u32 #0 50752
	store u32 1865916 #0
	call draw_char

	load u32 #0 1866068
	inc u32 #0
	jmp dcw_btn_loop
dcw_btn_done:
	ret

// ============================================================================
// itoa (P0 = value as i32, P1 = out_addr) -> R0 = length written (no NUL)
// ============================================================================
itoa:
	load i32 #0 1865904
	load u32 #1 1865908
	movi u32 #2 0

	cmpi i32 #0 0
	jge it_nonneg
	movi u32 #2 1
	movi i32 #3 0
	sub i32 #3 #0
	mov #0 #3
it_nonneg:
	cmpi u32 #0 0
	jnz it_extract
	movi u32 #3 48
	storer u8 #1 #3
	movi u32 #4 1
	store u32 1865944 #4
	ret

it_extract:
	movi u32 #5 0
	movi u32 #6 1866120
it_extract_loop:
	cmpi u32 #0 0
	jz it_extract_done
	mov #7 #0
	movi u32 #8 10
	mod u32 #7 #8
	addi u32 #7 48
	mov #9 #6
	add u32 #9 #5
	storer u8 #9 #7
	inc u32 #5
	movi u32 #8 10
	div u32 #0 #8
	jmp it_extract_loop
it_extract_done:
	movi u32 #10 0
	cmpi u32 #2 0
	jz it_no_sign
	movi u32 #11 45
	mov #12 #1
	storer u8 #12 #11
	movi u32 #10 1
it_no_sign:
	mov #13 #5
it_copy_loop:
	cmpi u32 #13 0
	jz it_copy_done
	subi u32 #13 1
	mov #14 #6
	add u32 #14 #13
	loadr u8 #15 #14
	mov #14 #1
	add u32 #14 #10
	storer u8 #14 #15
	inc u32 #10
	jmp it_copy_loop
it_copy_done:
	store u32 1865944 #10
	ret

// ============================================================================
// calc_format_display -> writes the text to show into DISPLAY_BUF,
// R0 = its length. Shows "Err" while CALC_ERROR is set.
// ============================================================================
calc_format_display:
	load u32 #0 1865896
	cmpi u32 #0 0
	jz cfd_normal

	movi u32 #0 1866136
	movi u32 #1 69
	storer u8 #0 #1
	movi u32 #0 1866136
	addi u32 #0 1
	movi u32 #1 114
	storer u8 #0 #1
	movi u32 #0 1866136
	addi u32 #0 2
	movi u32 #1 114
	storer u8 #0 #1
	movi u32 #4 3
	store u32 1865944 #4
	ret

cfd_normal:
	load i32 #0 1865888
	store u32 1865904 #0
	movi u32 #0 1866136
	store u32 1865908 #0
	call itoa
	ret

// ============================================================================
// calc_apply (P0=acc i32, P1=op u32, P2=cur i32) -> R0=result, R1=error(0/1)
// ============================================================================
calc_apply:
	load i32 #0 1865904
	load u32 #1 1865908
	load i32 #2 1865912

	cmpi u32 #1 1
	jz ca_add
	cmpi u32 #1 2
	jz ca_sub
	cmpi u32 #1 3
	jz ca_mul
	cmpi u32 #1 4
	jz ca_div

	store u32 1865944 #0
	movi u32 #3 0
	store u32 1865948 #3
	ret

ca_add:
	add i32 #0 #2
	jmp ca_ok
ca_sub:
	sub i32 #0 #2
	jmp ca_ok
ca_mul:
	mul i32 #0 #2
	jmp ca_ok
ca_div:
	cmpi i32 #2 0
	jnz ca_div_ok
	movi u32 #3 1
	store u32 1865948 #3
	movi u32 #4 0
	store u32 1865944 #4
	ret
ca_div_ok:
	div i32 #0 #2
ca_ok:
	store u32 1865944 #0
	movi u32 #3 0
	store u32 1865948 #3
	ret

// ============================================================================
// calc_press: dispatches on HC_CHARCODE (the key that was just clicked)
// ============================================================================
calc_press:
	load u32 #0 1866048

	load u32 #1 1865896
	cmpi u32 #1 0
	jz cp_not_error
	// while showing an error, only "C" (67) does anything
	cmpi u32 #0 67
	jz cp_clear
	ret
cp_not_error:

	cmpi u32 #0 48
	jl cp_check_c
	cmpi u32 #0 57
	jg cp_check_c
	// it's a digit
	subi u32 #0 48
	store u32 1866060 #0

	load u32 #1 1865900
	cmpi u32 #1 0
	jz cp_digit_append
	movi u32 #2 0
	store u32 1865888 #2
	store u32 1865900 #2
cp_digit_append:
	load i32 #1 1865888
	cmpi i32 #1 99999
	jg cp_ret
	movi u32 #2 10
	mul i32 #1 #2
	load u32 #3 1866060
	add i32 #1 #3
	store u32 1865888 #1
	ret

cp_check_c:
	cmpi u32 #0 67
	jnz cp_check_eq
cp_clear:
	movi u32 #1 0
	store u32 1865884 #1
	store u32 1865888 #1
	store u32 1865892 #1
	store u32 1865896 #1
	store u32 1865900 #1
	ret

cp_check_eq:
	cmpi u32 #0 61
	jnz cp_check_op
	load u32 #1 1865892
	cmpi u32 #1 0
	jz cp_ret
	load i32 #2 1865884
	store u32 1865904 #2
	store u32 1865908 #1
	load i32 #2 1865888
	store u32 1865912 #2
	call calc_apply
	load u32 #3 1865948
	cmpi u32 #3 1
	jnz cp_eq_ok
	movi u32 #4 1
	store u32 1865896 #4
	movi u32 #4 0
	store u32 1865884 #4
	store u32 1865888 #4
	store u32 1865892 #4
	ret
cp_eq_ok:
	load u32 #4 1865944
	store u32 1865884 #4
	store u32 1865888 #4
	movi u32 #4 0
	store u32 1865892 #4
	movi u32 #4 1
	store u32 1865900 #4
	ret

cp_check_op:
	// map the key to an operator code: + - * /
	movi u32 #1 0
	cmpi u32 #0 43
	jnz cp_op_try_minus
	movi u32 #1 1
	jmp cp_op_known
cp_op_try_minus:
	cmpi u32 #0 45
	jnz cp_op_try_mul
	movi u32 #1 2
	jmp cp_op_known
cp_op_try_mul:
	cmpi u32 #0 42
	jnz cp_op_try_div
	movi u32 #1 3
	jmp cp_op_known
cp_op_try_div:
	cmpi u32 #0 47
	jnz cp_ret
	movi u32 #1 4
cp_op_known:
	store u32 1866060 #1

	load u32 #2 1865892
	cmpi u32 #2 0
	jz cp_op_first

	// a previous op is pending -> fold it in first
	load i32 #3 1865884
	store u32 1865904 #3
	store u32 1865908 #2
	load i32 #3 1865888
	store u32 1865912 #3
	call calc_apply
	load u32 #4 1865948
	cmpi u32 #4 1
	jnz cp_op_fold_ok
	movi u32 #5 1
	store u32 1865896 #5
	movi u32 #5 0
	store u32 1865884 #5
	store u32 1865888 #5
	store u32 1865892 #5
	ret
cp_op_fold_ok:
	load u32 #5 1865944
	store u32 1865884 #5
	jmp cp_op_set

cp_op_first:
	load i32 #3 1865888
	store u32 1865884 #3

cp_op_set:
	load u32 #1 1866060
	store u32 1865892 #1
	movi u32 #1 1
	store u32 1865900 #1
cp_ret:
	ret

