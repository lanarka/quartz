// =============================================================================
// command.quartz - command line tool
//
// prompt> COMMAND
//
// Supported commands (only these two remain):
//   HELP             - print the list of commands
//   EXIT             - stop the VM (halt)
//
// Any other (unrecognized) command simply prints "Unknown command".
//
// Keyboard: same as in command.quartz - the VM reads physical key codes the
// way RAYLIB 5.5 reports them (KeyboardKey enum). Important codes:
//   32          KEY_SPACE
//   48-57       KEY_ZERO..KEY_NINE   (match ASCII '0'-'9')
//   65-90       KEY_A..KEY_Z         (match ASCII 'A'-'Z')
//   257         KEY_ENTER
//   259         KEY_BACKSPACE
//   280         KEY_CAPS_LOCK
//   340/344     KEY_LEFT_SHIFT / KEY_RIGHT_SHIFT
//
// Codes 65-90 (A-Z) are ALWAYS the same "uppercase" physical code regardless
// of whether an uppercase or lowercase letter is actually typed - the shell
// itself takes care of that:
//   - SHIFT (Left/Right) held AT THE SAME TIME as the letter -> UPPERCASE
//   - CAPS LOCK on (toggles on every press, exactly like a real keyboard)
//     -> UPPERCASE
//   - Shift + Caps Lock together -> they cancel out -> lowercase
//   - otherwise (neither) -> lowercase
// Digits/space/punctuation are NOT affected by Shift (the shell doesn't
// know e.g. Shift+1='!') - a deliberate simplification outside the scope
// of the assignment.
//
// LIMITATIONS (for simplicity):
//   - line length max. 62 characters, the command name is compared using
//     only the first 8 bytes
//   - no real text scrolling - once the bottom of the screen is reached,
//     the cursor simply wraps back to row 0 (overwriting from the top)
//
// Register map:
//   #0-#4   - local/temporary registers (freely usable in every section;
//             no subroutine except read_line/classify_key/print_char/
//             print_string uses them, so they survive a
//             call print_string/print_char).
//             In read_line, #1 additionally = repeat_timer (countdown for
//             typematic auto-repeat of a held key - does NOT need to
//             survive between separate calls to read_line, unlike
//             #7/#5/#6).
//   #5      - caps_on - Caps Lock state (0/1). PERSISTENT for the ENTIRE run.
//   #6      - caps_prev_held - was Caps Lock physically held last frame?
//             PERSISTENT.
//   #7      - prev_key - code of the last processed "primary" key.
//             PERSISTENT for the ENTIRE program run.
//   #8      - max_rows of the text grid (constant, from xtgetres at startup)
//   #9      - max_cols of the text grid (constant, from xtgetres at startup)
//   #10     - cur_x (current cursor column, persistent)
//   #11     - cur_y (current cursor row, persistent)
//   #12     - fg color (constant, white)
//   #13     - bg color (constant, black)
//   #14     - parameter/scratch used EXCLUSIVELY in print_char/read_line
//   #15     - parameter/scratch used EXCLUSIVELY in print_string
//
// RAM addresses:
//   200        - buffer for xikey (8 bytes)
//   250        - "cmdbuf": 8-byte, zero-padded copy of the command name
//   300        - input line (64 bytes, NUL-terminated)
//   6000..     - string literals (prompt, banner, help text, message)
//
// =============================================================================
%include "std.quartz"


	movi u32 #0 $std.BUS_DEV_VIDEO_TEXT
	movi u32 #1 $std.VTXT_CMD_CLEAR
	busout #0 #1 #1

	movi u32 #1 $std.VTXT_PORT_ROWS
	busin #0 #1 #8
	movi u32 #1 $std.VTXT_PORT_COLS
	busin #0 #1 #9

	movi u32 #12 0xFFFFFFFF     // fg = white, opaque
	movi u32 #13 0xFF000000     // bg = black, opaque
	movi u16 #10 0              // cur_x = 0
	movi u16 #11 0              // cur_y = 0

	movi u8 #2 2                // 2 = thin blinking cursor
	movi u32 #1 $std.VTXT_CMD_CURENA
	busout #0 #1 #2

	movi u32 #7 0                // #7 = prev_key, PERSISTENT for the entire run
	movi u32 #5 0                // #5 = caps_on, PERSISTENT
	movi u32 #6 0                // #6 = caps_prev_held, PERSISTENT


// --- string literals (written once at startup) -------------------------------

	// "prompt" @ 6000
	movi u8 #0 '>'
	store u8 6000 #0
	movi u8 #0 ' '
	store u8 6001 #0
	movi u8 #0 0
	store u8 6002 #0

	// "banner" @ 6003
	movi u8 #0 'Q'
	store u8 6003 #0
	movi u8 #0 'U'
	store u8 6004 #0
	movi u8 #0 'A'
	store u8 6005 #0
	movi u8 #0 'R'
	store u8 6006 #0
	movi u8 #0 'T'
	store u8 6007 #0
	movi u8 #0 'Z'
	store u8 6008 #0
	movi u8 #0 ' '
	store u8 6009 #0
	movi u8 #0 'L'
	store u8 6010 #0
	movi u8 #0 'I'
	store u8 6011 #0
	movi u8 #0 'T'
	store u8 6012 #0
	movi u8 #0 'E'
	store u8 6013 #0
	movi u8 #0 ' '
	store u8 6014 #0
	movi u8 #0 'S'
	store u8 6015 #0
	movi u8 #0 'H'
	store u8 6016 #0
	movi u8 #0 'E'
	store u8 6017 #0
	movi u8 #0 'L'
	store u8 6018 #0
	movi u8 #0 'L'
	store u8 6019 #0
	movi u8 #0 ' '
	store u8 6020 #0
	movi u8 #0 '1'
	store u8 6021 #0
	movi u8 #0 '.'
	store u8 6022 #0
	movi u8 #0 '0'
	store u8 6023 #0
	movi u8 #0 10
	store u8 6024 #0
	movi u8 #0 0
	store u8 6025 #0

	// "unknown_cmd" @ 6026
	movi u8 #0 'U'
	store u8 6026 #0
	movi u8 #0 'n'
	store u8 6027 #0
	movi u8 #0 'k'
	store u8 6028 #0
	movi u8 #0 'n'
	store u8 6029 #0
	movi u8 #0 'o'
	store u8 6030 #0
	movi u8 #0 'w'
	store u8 6031 #0
	movi u8 #0 'n'
	store u8 6032 #0
	movi u8 #0 ' '
	store u8 6033 #0
	movi u8 #0 'c'
	store u8 6034 #0
	movi u8 #0 'o'
	store u8 6035 #0
	movi u8 #0 'm'
	store u8 6036 #0
	movi u8 #0 'm'
	store u8 6037 #0
	movi u8 #0 'a'
	store u8 6038 #0
	movi u8 #0 'n'
	store u8 6039 #0
	movi u8 #0 'd'
	store u8 6040 #0
	movi u8 #0 10
	store u8 6041 #0
	movi u8 #0 0
	store u8 6042 #0

	// "help_text" @ 6043
	movi u8 #0 'A'
	store u8 6043 #0
	movi u8 #0 'v'
	store u8 6044 #0
	movi u8 #0 'a'
	store u8 6045 #0
	movi u8 #0 'i'
	store u8 6046 #0
	movi u8 #0 'l'
	store u8 6047 #0
	movi u8 #0 'a'
	store u8 6048 #0
	movi u8 #0 'b'
	store u8 6049 #0
	movi u8 #0 'l'
	store u8 6050 #0
	movi u8 #0 'e'
	store u8 6051 #0
	movi u8 #0 ' '
	store u8 6052 #0
	movi u8 #0 'c'
	store u8 6053 #0
	movi u8 #0 'o'
	store u8 6054 #0
	movi u8 #0 'm'
	store u8 6055 #0
	movi u8 #0 'm'
	store u8 6056 #0
	movi u8 #0 'a'
	store u8 6057 #0
	movi u8 #0 'n'
	store u8 6058 #0
	movi u8 #0 'd'
	store u8 6059 #0
	movi u8 #0 's'
	store u8 6060 #0
	movi u8 #0 ':'
	store u8 6061 #0
	movi u8 #0 10
	store u8 6062 #0
	movi u8 #0 ' '
	store u8 6063 #0
	movi u8 #0 ' '
	store u8 6064 #0
	movi u8 #0 'H'
	store u8 6065 #0
	movi u8 #0 'E'
	store u8 6066 #0
	movi u8 #0 'L'
	store u8 6067 #0
	movi u8 #0 'P'
	store u8 6068 #0
	movi u8 #0 ' '
	store u8 6069 #0
	movi u8 #0 ' '
	store u8 6070 #0
	movi u8 #0 ' '
	store u8 6071 #0
	movi u8 #0 's'
	store u8 6072 #0
	movi u8 #0 'h'
	store u8 6073 #0
	movi u8 #0 'o'
	store u8 6074 #0
	movi u8 #0 'w'
	store u8 6075 #0
	movi u8 #0 ' '
	store u8 6076 #0
	movi u8 #0 't'
	store u8 6077 #0
	movi u8 #0 'h'
	store u8 6078 #0
	movi u8 #0 'i'
	store u8 6079 #0
	movi u8 #0 's'
	store u8 6080 #0
	movi u8 #0 ' '
	store u8 6081 #0
	movi u8 #0 't'
	store u8 6082 #0
	movi u8 #0 'e'
	store u8 6083 #0
	movi u8 #0 'x'
	store u8 6084 #0
	movi u8 #0 't'
	store u8 6085 #0
	movi u8 #0 10
	store u8 6086 #0
	movi u8 #0 ' '
	store u8 6087 #0
	movi u8 #0 ' '
	store u8 6088 #0
	movi u8 #0 'E'
	store u8 6089 #0
	movi u8 #0 'X'
	store u8 6090 #0
	movi u8 #0 'I'
	store u8 6091 #0
	movi u8 #0 'T'
	store u8 6092 #0
	movi u8 #0 ' '
	store u8 6093 #0
	movi u8 #0 ' '
	store u8 6094 #0
	movi u8 #0 ' '
	store u8 6095 #0
	movi u8 #0 'h'
	store u8 6096 #0
	movi u8 #0 'a'
	store u8 6097 #0
	movi u8 #0 'l'
	store u8 6098 #0
	movi u8 #0 't'
	store u8 6099 #0
	movi u8 #0 ' '
	store u8 6100 #0
	movi u8 #0 't'
	store u8 6101 #0
	movi u8 #0 'h'
	store u8 6102 #0
	movi u8 #0 'e'
	store u8 6103 #0
	movi u8 #0 ' '
	store u8 6104 #0
	movi u8 #0 'V'
	store u8 6105 #0
	movi u8 #0 'M'
	store u8 6106 #0
	movi u8 #0 10
	store u8 6107 #0
	movi u8 #0 0
	store u8 6108 #0


// --- banner --------------------------------------------------------------

	movi u32 #15 6003
	call print_string


// =============================================================================
// main_loop - print the prompt, read a line, parse and execute the command
// =============================================================================

main_loop:
	movi u32 #15 6000
	call print_string
	call read_line
	
	movi u32 #0 $std.BUS_DEV_VIDEO_TEXT
	movi u32 #1 $std.VTXT_PORT_X
	busout #0 #1 #10
	movi u32 #1 $std.VTXT_PORT_Y
	busout #0 #1 #11
	movi u32 #1 $std.VTXT_CMD_CURSET
	busout #0 #1 #1

	// --- find the first space in the line (even though this shell doesn't
	//     need it, it ensures only the first word of the line is compared) --
	movi u32 #2 300
find_space_loop:
	loadr u8 #3 #2
	cmpi u8 #3 0
	jz split_done
	cmpi u8 #3 32
	jz split_done
	inc u32 #2
	jmp find_space_loop
split_done:

	// --- build an 8-byte, zero-padded "cmdbuf" for comparison --------------
	movi u32 #0 250
	movi u32 #2 0
	movi u32 #4 8
	memset #0 #2 #4

	load u8 #3 300
	cmpi u8 #3 0
	jz cmdbuf_done
	store u8 250 #3
	load u8 #3 301
	cmpi u8 #3 0
	jz cmdbuf_done
	store u8 251 #3
	load u8 #3 302
	cmpi u8 #3 0
	jz cmdbuf_done
	store u8 252 #3
	load u8 #3 303
	cmpi u8 #3 0
	jz cmdbuf_done
	store u8 253 #3
	load u8 #3 304
	cmpi u8 #3 0
	jz cmdbuf_done
	store u8 254 #3
	load u8 #3 305
	cmpi u8 #3 0
	jz cmdbuf_done
	store u8 255 #3
	load u8 #3 306
	cmpi u8 #3 0
	jz cmdbuf_done
	store u8 256 #3
	load u8 #3 307
	cmpi u8 #3 0
	jz cmdbuf_done
	store u8 257 #3
cmdbuf_done:

	// --- compare the whole 8-byte "cmdbuf" at once as a single u64 number ---
	load u64 #0 250

	cmpi u64 #0 0
	jz do_empty
	cmpi u64 #0 0x706C6568
	jz do_help
	cmpi u64 #0 0x74697865
	jz do_exit
	jmp do_unknown


// --- HELP ------------------------------------------------------------------
do_help:
	movi u32 #15 6043
	call print_string
	jmp main_loop


// --- EXIT --------------------------------------------------------------------
do_exit:
	halt


// --- empty line (Enter with no command) -> just show the prompt again ------
do_empty:
	jmp main_loop


// --- unknown commands ---------------------------------------------------------
do_unknown:
	movi u32 #15 6026
	call print_string
	jmp main_loop


// =============================================================================
// print_char - draws one character and advances the cursor (#10,#11)
//   input:  #14 = character codepoint (10 = newline)
// =============================================================================
print_char:
	cmpi u16 #14 10
	jz pc_newline

	
	// NOTE: uses #2/#3 as bus scratch, NOT #0/#1 - callers in read_line
	// (rl_store_char/rl_backspace) keep the live line length in #0 and the
	// live repeat_timer in #1 across this call, so those two must not be
	// touched here.
	movi u32 #2 $std.BUS_DEV_VIDEO_TEXT
	movi u32 #3 $std.VTXT_PORT_X
	busout #2 #3 #10
	movi u32 #3 $std.VTXT_PORT_Y
	busout #2 #3 #11
	movi u32 #3 $std.VTXT_PORT_CODEPOINT
	busout #2 #3 #14
	movi u32 #3 $std.VTXT_PORT_FG
	busout #2 #3 #12
	movi u32 #3 $std.VTXT_PORT_BG
	busout #2 #3 #13
	movi u32 #3 $std.VTXT_CMD_CHAR
	busout #2 #3 #3

	inc u16 #10
	cmp u16 #10 #9
	jl pc_check_row
	movi u16 #10 0
	inc u16 #11
	jmp pc_check_row

pc_newline:
	movi u16 #10 0
	inc u16 #11

pc_check_row:
	cmp u16 #11 #8
	jl pc_done
	movi u16 #11 0               // no real scrolling - wrap to the top

pc_done:
	
	movi u32 #2 $std.BUS_DEV_VIDEO_TEXT
	movi u32 #3 $std.VTXT_PORT_X
	busout #2 #3 #10
	movi u32 #3 $std.VTXT_PORT_Y
	busout #2 #3 #11
	movi u32 #3 $std.VTXT_CMD_CURSET
	busout #2 #3 #3
	ret


// =============================================================================
// print_string - print a NUL-terminated string
//   input:  #15 = string address (changes during execution - treat as scratch)
// =============================================================================
print_string:
	loadr u8 #14 #15
	cmpi u8 #14 0
	jz ps_done
	call print_char
	inc u32 #15
	jmp print_string
ps_done:
	ret


// =============================================================================
// classify_key - evaluates one physical key code (RAYLIB 5.5) while
// scanning all 4 slots from xikey.
//   input:  #4 = key code
//   output: #2 = shift_flag, #3 = primary_key
// =============================================================================
classify_key:
	cmpi u32 #4 340               // KEY_LEFT_SHIFT
	jz ck_shift
	cmpi u32 #4 344               // KEY_RIGHT_SHIFT
	jz ck_shift
	cmpi u32 #4 0
	jz ck_done
	cmpi u32 #4 280               // KEY_CAPS_LOCK - handled separately
	jz ck_done
	cmpi u32 #4 341               // KEY_LEFT_CONTROL
	jz ck_done
	cmpi u32 #4 342               // KEY_LEFT_ALT
	jz ck_done
	cmpi u32 #4 343               // KEY_LEFT_SUPER
	jz ck_done
	cmpi u32 #4 345               // KEY_RIGHT_CONTROL
	jz ck_done
	cmpi u32 #4 346               // KEY_RIGHT_ALT
	jz ck_done
	cmpi u32 #4 347               // KEY_RIGHT_SUPER
	jz ck_done
	cmpi u32 #4 348               // KEY_KB_MENU
	jz ck_done
	cmpi u32 #3 0
	jnz ck_done
	mov #3 #4
	jmp ck_done
ck_shift:
	movi u32 #2 1
ck_done:
	ret


// =============================================================================
// read_line - reads one line from the keyboard into RAM at address 300
// (max 62 characters + NUL), with screen echo, BACKSPACE, typematic auto-repeat
// and SHIFT / CAPS LOCK support (uppercase/lowercase letters).
// =============================================================================
read_line:
	movi u32 #0 300
	movi u32 #1 0
	movi u32 #2 64
	memset #0 #1 #2

	movi u32 #0 0                // #0 = current line length

rl_loop:
	
	movi u32 #4 $std.BUS_DEV_VIDEO
	movi u32 #14 $std.VIDEO_CMD_VSYNC
	busout #4 #14 #14

	movi u32 #2 200
	
	movi u32 #14 $std.BUS_DEV_KEYBOARD
	movi u32 #4 $std.KBD_PORT_POLL
	movi u32 #3 8
	businb #14 #4 #2 #3 #3          // #3 = number of currently held keys

	// --- Phase A: Caps Lock - a 0->1 edge toggles caps_on (#5) ---------------
	movi u32 #4 0
	load u16 #3 200
	cmpi u32 #3 280
	jnz capA_1
	movi u32 #4 1
capA_1:
	load u16 #3 202
	cmpi u32 #3 280
	jnz capA_2
	movi u32 #4 1
capA_2:
	load u16 #3 204
	cmpi u32 #3 280
	jnz capA_3
	movi u32 #4 1
capA_3:
	load u16 #3 206
	cmpi u32 #3 280
	jnz capA_4
	movi u32 #4 1
capA_4:
	cmp u32 #4 #6
	jz capA_done
	mov #6 #4
	cmpi u32 #4 0
	jz capA_done
	movi u32 #3 1
	xor u32 #5 #3
capA_done:

	// --- Phase B: shift_flag (#2) and primary_key (#3) from all 4 slots ----
	movi u32 #2 0
	movi u32 #3 0
	load u16 #4 200
	call classify_key
	load u16 #4 202
	call classify_key
	load u16 #4 204
	call classify_key
	load u16 #4 206
	call classify_key

	cmpi u32 #3 0
	jz rl_release

	cmp u32 #3 #7
	jz rl_held

	mov #7 #3
	movi u32 #1 30
	jmp rl_apply_case

rl_held:
	dec u32 #1
	cmpi u32 #1 0
	jg rl_loop
	movi u32 #1 4

rl_apply_case:
	cmpi u32 #3 257
	jz rl_enter
	cmpi u32 #3 259
	jz rl_backspace
	cmpi u32 #3 32
	jl rl_loop
	cmpi u32 #3 90
	jg rl_loop
	cmpi u32 #0 62
	jge rl_loop

	cmpi u32 #3 65
	jl rl_store_char
	cmpi u32 #3 90
	jg rl_store_char
	mov #4 #2
	xor u32 #4 #5
	cmpi u32 #4 1
	jz rl_store_char
	addi u32 #3 32

rl_store_char:
	mov #4 #0
	addi u32 #4 300
	storer u8 #4 #3
	inc u32 #0
	mov #14 #3
	call print_char
	jmp rl_loop

rl_backspace:
	cmpi u32 #0 0
	jz rl_loop
	dec u32 #0
	cmpi u16 #10 0
	jz rl_loop
	dec u16 #10
	movi u16 #14 32
	movi u32 #2 $std.BUS_DEV_VIDEO_TEXT
	movi u32 #4 $std.VTXT_PORT_X
	busout #2 #4 #10
	movi u32 #4 $std.VTXT_PORT_Y
	busout #2 #4 #11
	movi u32 #4 $std.VTXT_PORT_CODEPOINT
	busout #2 #4 #14
	movi u32 #4 $std.VTXT_PORT_FG
	busout #2 #4 #12
	movi u32 #4 $std.VTXT_PORT_BG
	busout #2 #4 #13
	movi u32 #4 $std.VTXT_CMD_CHAR
	busout #2 #4 #4

	movi u32 #4 $std.VTXT_PORT_X
	busout #2 #4 #10
	movi u32 #4 $std.VTXT_PORT_Y
	busout #2 #4 #11
	movi u32 #4 $std.VTXT_CMD_CURSET
	busout #2 #4 #4
	jmp rl_loop

rl_enter:
	mov #4 #0
	addi u32 #4 300
	movi u8 #2 0
	storer u8 #4 #2
	movi u16 #14 10
	call print_char
	ret

rl_release:
	movi u32 #7 0
	jmp rl_loop
